":500,"question":"¿Qué diferencia de Puntos BBVA existe entre Infinite (23%) y Platinum (15%)?","answer":"8 puntos porcentuales"},{"id":"BBVA-500-10","category":"BBVA","value":500,"question":"Si una compra elegible de $10,000 se toma solo como base porcentual, ¿qué porcentaje de Puntos BBVA corresponde a Platinum según su tasa publicada?","answer":"15%, equivalente a una base de 1,500 puntos bajo esa relación porcentual, sujeto a reglas del programa"}];
const CATS=['Deportes','Ciencia','Historia','Películas','Geografía','BBVA']; const VALUES=[100,200,300,400,500];
let activeTeam=0, scores=[0,0,0,0], boardQuestions={}, usedCells=new Set(), current=null, timerInt=null, timeLeft=30;
const $=s=>document.querySelector(s); const esc=s=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
function usedIds(){try{return JSON.parse(localStorage.getItem('jeopardy_used_ids')||'[]')}catch{return[]}}
function saveUsed(arr){localStorage.setItem('jeopardy_used_ids',JSON.stringify(arr))}
function pickQuestion(cat,val,used){let pool=BANK.filter(x=>x.category===cat&&x.value===val), avail=pool.filter(x=>!used.includes(x.id)); if(!avail.length){used=used.filter(id=>!pool.some(x=>x.id===id)); avail=pool.slice()} let q=avail[Math.floor(Math.random()*avail.length)]; return [q,used]}
function buildTeams(){let names=JSON.parse(localStorage.getItem('jeopardy_team_names')||'["Equipo 1","Equipo 2","Equipo 3","Equipo 4"]'); $('#teams').innerHTML=names.map((n,i)=>`<div class="team ${i===activeTeam?'active':''}" data-i="${i}"><input value="${esc(n)}" aria-label="Nombre equipo ${i+1}"><div class="score">${scores[i]}</div></div>`).join(''); document.querySelectorAll('.team').forEach(t=>{t.onclick=e=>{if(e.target.tagName!=='INPUT'){activeTeam=+t.dataset.i; buildTeams()}}}); document.querySelectorAll('.team input').forEach((inp,i)=>inp.onchange=()=>{names[i]=inp.value||`Equipo ${i+1}`;localStorage.setItem('jeopardy_team_names',JSON.stringify(names))})}
function newGame(){scores=[0,0,0,0];activeTeam=0;usedCells=new Set();boardQuestions={};let used=usedIds(); for(const c of CATS){for(const v of VALUES){let res=pickQuestion(c,v,used);boardQuestions[c+'|'+v]=res[0];used=res[1]; used.push(res[0].id)}} saveUsed([...new Set(used)]); renderBoard(); buildTeams(); $('#winner').textContent=''}
function renderBoard(){let h=''; for(const c of CATS)h+=`<div class="cat">${esc(c)}</div>`; for(const v of VALUES){for(const c of CATS){let k=c+'|'+v; h+=`<div class="cell ${usedCells.has(k)?'used':''}" data-k="${esc(k)}">${usedCells.has(k)?'':v}</div>`}} $('#board').innerHTML=h; document.querySelectorAll('.cell:not(.used)').forEach(el=>el.onclick=()=>openQuestion(el.dataset.k))}
function teamName(i){return document.querySelectorAll('.team input')[i]?.value||`Equipo ${i+1}`}
function openQuestion(k){current={k,q:boardQuestions[k]}; $('#meta').textContent=`${current.q.category} · ${current.q.value} puntos`; $('#question').textContent=current.q.question; $('#answer').style.display='none'; $('#answer').textContent='Respuesta: '+current.q.answer; $('#actions').innerHTML='<button class="primary" id="reveal">Ver respuesta</button>'; $('#reveal').onclick=reveal; $('#activeLabel').textContent='Responde: '+teamName(activeTeam); $('#modal').classList.add('show'); startTimer()}
function startTimer(){clearInterval(timerInt);timeLeft=30;$('#timer').textContent=timeLeft;timerInt=setInterval(()=>{timeLeft--;$('#timer').textContent=timeLeft;if(timeLeft<=0){clearInterval(timerInt);reveal()}},1000)}
function reveal(){clearInterval(timerInt);$('#answer').style.display='block';$('#actions').innerHTML='<button class="good" id="correct">✓ Correcto</button><button class="bad" id="wrong">✗ Incorrecto</button><button class="secondary" id="cancel">Cerrar sin puntuar</button>';$('#correct').onclick=()=>score(true);$('#wrong').onclick=()=>score(false);$('#cancel').onclick=()=>closeModal(false)}
function score(ok){scores[activeTeam]+=ok?current.q.value:-current.q.value;usedCells.add(current.k);closeModal(true);buildTeams();renderBoard();checkWinner()}
function closeModal(mark){clearInterval(timerInt);$('#modal').classList.remove('show');current=null}
function checkWinner(){if(usedCells.size===30){let max=Math.max(...scores), winners=scores.map((s,i)=>s===max?teamName(i):null).filter(Boolean);$('#winner').textContent=winners.length===1?`Ganador: ${winners[0]} con ${max} puntos`:`Empate: ${winners.join(', ')} con ${max} puntos`}}
$('#newGame').onclick=()=>{if(confirm('¿Iniciar una nueva partida con preguntas diferentes?'))newGame()}; $('#resetBank').onclick=()=>{if(confirm('Esto permitirá que vuelvan a salir preguntas anteriores. ¿Continuar?')){localStorage.removeItem('jeopardy_used_ids');alert('Banco reiniciado. La próxima partida podrá usar cualquier pregunta.')}}; $('#fullscreen').onclick=()=>{if(!document.fullscreenElement)document.documentElement.requestFullscreen?.();else document.exitFullscreen?.()};
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#modal').classList.contains('show'))closeModal(false)}); newGame();
</script></body></html>
